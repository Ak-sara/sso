MONGODB_URI=mongodb+srv://root:password@devday.wmveufv.mongodb.net/?retryWrites=true&w=majority&appName=DevDay
MONGODB_DB=dev_sso

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-change-in-production

APPNAME=IAS SSO

# Audit log forwarding to a syslog-based SIEM (e.g. Wazuh) — optional.
# Leave AUDIT_SYSLOG_HOST unset to skip; audit events always still go to MongoDB.
# AUDIT_SYSLOG_HOST=127.0.0.1
# AUDIT_SYSLOG_PORT=514
# AUDIT_SYSLOG_PROTOCOL=udp
# Optional allowlist of topics to forward (auth, identity, oauth, scim, sync, org, general).
# Unset = forward every topic. MongoDB always keeps the complete trail regardless.
# AUDIT_SYSLOG_TOPICS=auth,identity,oauth,scim
